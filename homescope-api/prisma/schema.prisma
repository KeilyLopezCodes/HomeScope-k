generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo temporal para inicializar el cliente de Prisma.
// El modelo completo se definirá en la HU-04.
model Placeholder {
  id Int @id @default(autoincrement())

  @@map("placeholder")
}

# URL base de la API backend
VITE_API_URL=http://localhost:3000

# Clave de browser para Google Maps (solo lectura, sin restricción de servidor)
VITE_GOOGLE_MAPS_BROWSER_KEY=your_browser_key

# Nombre del cloud de Cloudinary para subida de imágenes
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Sesión simulada para desarrollo (sin backend)
# Valores: true | false  — solo tiene efecto cuando NODE_ENV=development
# Con true, usar mockSignIn('comprador'|'vendedor'|'administrador'|'visitante')
VITE_MOCK_AUTH=false
